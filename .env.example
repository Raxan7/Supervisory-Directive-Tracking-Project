APP_NAME=Supervisory Findings and Directives Tracking API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://supervisory:supervisory@db:5432/supervisory
SECRET_KEY=replace-with-at-least-32-random-characters
ACCESS_TOKEN_MINUTES=60
ALLOWED_ORIGINS=http://localhost:5173
UPLOAD_DIR=/app/uploads
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.org
SMTP_USE_TLS=true
ALERT_SCAN_SECONDS=300
ALERT_DAYS_BEFORE=7
MAX_UPLOAD_BYTES=10485760
BOOTSTRAP_ADMIN_EMAIL=admin@example.org
BOOTSTRAP_ADMIN_PASSWORD=change-this-before-startup
BOOTSTRAP_ADMIN_NAME=System Administrator
